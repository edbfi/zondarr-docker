#!/command/with-contenv bash
# shellcheck shell=bash

umask "${UMASK}"

cd "${APP_DIR}/frontend" || exit 1

# Override HOST/PORT for the Bun/SvelteKit server
export HOST="0.0.0.0"
export PORT="${FRONTEND_PORT}"

# scripts/serve.ts fronts the adapter when ORIGIN is set; without it, it loads build/index.js.
exec s6-setuidgid hotio bun ./scripts/serve.ts
