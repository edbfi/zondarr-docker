#!/command/with-contenv bash
# shellcheck shell=bash

umask "${UMASK}"

cd "${APP_DIR}/backend" || exit 1

# Keep --workers-kill-timeout small: 4 s plus the s6 teardown (about 3.3 s) fits Docker's
# default 10 s stop timeout when a client holds a connection open on this port.
exec s6-setuidgid hotio \
    "${APP_DIR}/backend/.venv/bin/python" -m litestar \
    --app zondarr.app:app \
    run \
    --host 0.0.0.0 \
    --port "${BACKEND_PORT}" \
    --workers "${GRANIAN_WORKERS:-1}" \
    --runtime-mode st \
    --backpressure 16 \
    --respawn-failed-workers \
    --workers-kill-timeout 4 \
    --workers-lifetime 6h \
    --granian-log-level info
